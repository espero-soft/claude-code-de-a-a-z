{
  "mcpServers": {
    "sqlite": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--exclude-newer",
        "2025-06-01",
        "mcp-server-sqlite==2025.4.25",
        "--db-path",
        "./dev.db"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless"
      ],
      "env": {}
    },
    "regles-metier": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "tsx",
        "mcp/regles-metier/index.ts"
      ],
      "env": {
        "DATABASE_URL": "file:./dev.db"
      }
    },
    "stripe": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp@0.3.3"
      ],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    }
  }
}