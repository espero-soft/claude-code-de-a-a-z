# Copier ce fichier en .env
# Base SQLite locale, créée à la racine du projet (jamais commitée)
DATABASE_URL="file:./dev.db"

# Clé secrète Stripe du mode TEST (tableau de bord Stripe > Développeurs > Clés API).
# Une clé live (sk_live_…) est refusée par l'application.
STRIPE_SECRET_KEY="sk_test_..."

# Authentification (Better Auth). Secret d'au moins 32 caractères, propre à
# chaque environnement : le générer avec `npx auth secret` ou `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Adresse publique de l'application (sert aux contrôles d'origine).
BETTER_AUTH_URL="http://localhost:3000"

# Envoi des e-mails (codes de connexion). En développement : Mailpit,
# SMTP sur le port 1025, boîte lisible sur http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT=1025
# Laisser vides avec Mailpit ; à renseigner avec un vrai serveur SMTP.
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
COURRIEL_EXPEDITEUR="Réunéa <ne-pas-repondre@reunea.test>"

# Clé de l'API Claude (console Anthropic > API Keys), utilisée par npm run premier-appel.
ANTHROPIC_API_KEY=

# Facultatif : adresse du premier administrateur pour `npm run admin:creer`
# (sinon la passer en argument : npm run admin:creer -- <e-mail>).
ADMIN_EMAIL=
