// Schéma de la base, d'après le cahier des charges (entités Salle et Réservation).
// Tous les montants sont stockés en centimes (entiers) pour éviter les erreurs d'arrondi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Salle {
  id                String        @id @default(cuid())
  slug              String        @unique
  nom               String
  description       String
  capacite          Int // nombre de personnes
  prixHeureCentimes Int // prix par heure, en centimes
  photo             String?
  active            Boolean       @default(true)
  equipements       Equipement[]
  reservations      Reservation[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// SQLite ne stocke pas de listes : les équipements ont leur table, reliée aux salles.
model Equipement {
  id     String  @id @default(cuid())
  nom    String  @unique
  salles Salle[]
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

model Reservation {
  id                   String            @id @default(cuid())
  salleId              String
  salle                Salle             @relation(fields: [salleId], references: [id])
  debut                DateTime // date et heure de début
  fin                  DateTime // date et heure de fin
  nomClient            String
  emailClient          String
  statut               StatutReservation @default(EN_ATTENTE)
  montantTotalCentimes Int
  // Dernière session Stripe Checkout ouverte pour la payer (null avant le
  // premier clic sur « Payer ») : le serveur la relit auprès de Stripe pour
  // vérifier le paiement.
  stripeSessionId      String?           @unique
  createdAt            DateTime          @default(now())
  tickets              Ticket[]
  // Compte titulaire (module 12) : seul lui, l'employé et l'administrateur
  // voient la réservation. Null pour les réservations d'avant les comptes.
  // Le compte supprimé, la réservation reste, sans titulaire.
  utilisateurId        String?
  utilisateur          User?             @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([salleId, debut])
  @@index([utilisateurId])
}

// Tickets du support (module 10) : message d'un client, trié par le modèle
// (trierTicket) et accompagné d'un brouillon de réponse (proposerReponse).
// Le brouillon n'est jamais envoyé : un conseiller le valide sur /admin/tickets.
// Les valeurs reprennent celles du schéma TriTicket (src/lib/tri-ticket.ts).
enum CategorieTicket {
  reservation
  paiement
  annulation
  autre
}

enum UrgenceTicket {
  basse
  normale
  haute
}

enum StatutTicket {
  A_TRAITER
  VALIDE
}

model Ticket {
  id                String          @id @default(cuid())
  message           String
  email             String
  categorie         CategorieTicket
  urgence           UrgenceTicket
  resume            String
  // Réservation identifiée par le tri (null si aucune ne correspond). Si elle
  // est supprimée, le ticket reste, sans réservation.
  reservationId     String?
  reservation       Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  brouillon         String
  aTransmettre      Boolean // un conseiller doit reprendre la main
  motifTransmission String?
  statut            StatutTicket    @default(A_TRAITER)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  valideLe          DateTime? // date de validation du brouillon

  @@index([statut])
}

// Authentification (module 12) : tables générées par la CLI de Better Auth
// (`npx auth generate --config src/lib/auth.ts --output prisma/schema.prisma`),
// noms et champs en anglais imposés par la bibliothèque. Ne pas les modifier à
// la main : relancer la génération après un changement de src/lib/auth.ts.
// Connexion par code à 6 chiffres envoyé par e-mail, sans mot de passe :
// les codes (empreintes) vivent dans Verification, jamais en clair.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  // Champ ajouté par `user.additionalFields` (src/lib/auth.ts) : CLIENT,
  // EMPLOYE ou ADMIN, relu par lireRole (src/lib/roles.ts).
  role          String?   @default("CLIENT")
  reservations  Reservation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Compteurs de la limite par adresse e-mail de la connexion par code
// (src/lib/limite-connexion.ts, SECURITE.md section 10) : envois de codes et
// essais de code, quelle que soit l'adresse IP. Table distincte de rateLimit,
// que Better Auth purge au-delà de sa propre fenêtre (60 s).
model LimiteConnexion {
  cle    String   @id // « envoi:<e-mail> » ou « essai:<e-mail> »
  nombre Int // demandes comptées dans la fenêtre en cours
  debut  DateTime // début de la fenêtre en cours
}
